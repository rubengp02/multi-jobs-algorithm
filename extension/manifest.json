{
  "manifest_version": 3,
  "name": "LinkedIn Jobs - Receptor local",
  "version": "1.1.5",
  "description": "Audita la primera página de LinkedIn y la entrega al bot local.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn Jobs",
    "default_popup": "popup.html"
  }
}
