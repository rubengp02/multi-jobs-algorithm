# =========================
# General
# =========================
POLL_SECONDS=900
JITTER_SECONDS=20
TIMEOUT_SECONDS=25
# Set to 0 to send every eligible, unseen offer in the same cycle.
MAX_NOTIFS_PER_CYCLE=0
SILENT_ON_START=true
RETRY_ON_ZERO_ATTEMPTS=2
RETRY_ON_ZERO_DELAY_SEC=8
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_DELAY_SEC=5
LOG_LEVEL=INFO
DEBUG_DIR=./data/debug
DEBUG_RETENTION_DAYS=7
DEBUG_MAX_FILES=400

# Optional, precise title/company phrases. Avoid broad terms such as data,
# python, power or senior: they can hide valid vacancies.
EXCLUDE_WORDS=
# Optional guard for non-LinkedIn providers. Configured LinkedIn search URLs
# are already the candidate scope and are evaluated by the relevance classifier.
INCLUDE_WORDS=

# Comma-separated list: linkedin,indeed,infojobs,tecnoempleo,manfred,remotive,wwr,greenhouse_spain,remoteok,upv_sie,experis,accessiway
# Las consultoras requieren una auditoria previa con estado "validated" y se
# activan manualmente por identificador; se dejan fuera de este ejemplo.
ENABLED_PROVIDERS=linkedin

# =========================
# Auditoria operativa diaria
# =========================
# Reads persisted runtime evidence only: no extra scrape, no seen changes, and
# no job alerts. Its Telegram message is a daily diagnostic summary.
DAILY_COVERAGE_DIR=./data/daily_coverage
DAILY_COVERAGE_LOOKBACK_HOURS=26
DAILY_COVERAGE_MIN_CYCLE_RATIO=0.80
DAILY_COVERAGE_MAX_STALE_MINUTES=50
DAILY_COVERAGE_TELEGRAM_SUMMARY=true

# Retencion de telemetria generada (dias). Nunca borra data/seen_jobs.txt.
# El ledger por oferta guarda solo hashes y resultado terminal, no descripciones.
JOB_AUDIT_RETENTION_DAYS=35
OPERATIONAL_METRICS_RETENTION_DAYS=90
DAILY_COVERAGE_RETENTION_DAYS=90
PROVIDER_VALIDATION_RETENTION_DAYS=180
# Perfil y cookies se conservan. Solo se borran caches regenerables y copias
# de sesion con antiguedad superior a estos limites.
BROWSER_SESSION_BACKUP_RETENTION_DAYS=14
BROWSER_EXTENSION_RUNTIME_RETENTION_DAYS=30

# Maximum technical/viable Experis jobs to process from the public index each cycle.
EXPERIS_MAX_RESULTS=60

# Maximum Accessiway jobs to process from its public Teamtailor board each cycle.
ACCESSIWAY_MAX_RESULTS=100

# =========================
# Consultoras publicas
# =========================
# Cada fuente aprobada consulta como maximo dos paginas y 50 ofertas unicas.
# La pausa se aplica entre proveedores consultados de forma secuencial.
CONSULTANCY_MAX_PAGES=2
CONSULTANCY_MAX_RESULTS=50
PROVIDER_INTER_REQUEST_MIN_SECONDS=3
PROVIDER_INTER_REQUEST_MAX_SECONDS=6
# Los informes JSON no guardan HTML, cookies ni credenciales.
PROVIDER_VALIDATION_DIR=./data/provider_validation
PROVIDER_VALIDATION_AUTO_ON_ANOMALY=true
PROVIDER_VALIDATION_MAX_PAGES=5
PROVIDER_VALIDATION_MAX_RESULTS=100

# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Seconds Telegram keeps one getUpdates request open. This prevents rate limits from rapid polling.
TELEGRAM_POLL_TIMEOUT_SECONDS=20

# =========================
# LinkedIn
# =========================
# URL base ordenada por fecha. El bot conserva todos sus parametros y solo ajusta f_TPR.
LINKEDIN_URL=https://www.linkedin.com/jobs/search/?geoId=90009816&keywords=software&sortBy=DD
# Por cada URL base, primero consulta los ultimos 20 minutos y despues la ultima hora.
LINKEDIN_TIME_WINDOWS_SECONDS=1200,3600
# Pausa aleatoria entre cada consulta LinkedIn, incluida la transicion 20 min -> 1 h.
LINKEDIN_INTER_SEARCH_MIN_SECONDS=3
LINKEDIN_INTER_SEARCH_MAX_SECONDS=6
LINKEDIN_SESSION_DIR=./data/linkedin_session
# Para pruebas en Windows, suele ayudar poner false
LINKEDIN_HEADLESS=true
LINKEDIN_AUTO_LOGIN=false
LINKEDIN_FORCE_LOGIN_FLOW_TEST=false
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_FIRST_PAGE_ONLY=true
# Se extraen las 25 ofertas mas recientes de cada URL; no limita alertas validas.
LINKEDIN_MAX_JOBS=25
LINKEDIN_STARTUP_SCROLLS=12
LINKEDIN_SCROLLS=6
LINKEDIN_SCROLL_PAUSE_SEC=1.2
LINKEDIN_MIN_EXPECTED=15
LINKEDIN_VERBOSE_LOGS=false
# Chromium autenticado es la fuente principal. La API publica solo se usa como
# respaldo tras dos intervalos sin un lote completo de la extension.
LINKEDIN_EXTENSION_ENABLED=true
LINKEDIN_EXTENSION_HOST=127.0.0.1
LINKEDIN_EXTENSION_PORT=8765
LINKEDIN_EXTENSION_REFRESH_SECONDS=900

# Cache acotada de decisiones de relevancia rechazadas o dudosas. No guarda
# ofertas vistas y se invalida si cambia el contenido de la oferta.
RELEVANCE_CACHE_RETENTION_DAYS=7
RELEVANCE_CACHE_MAX_ITEMS=4000

# =========================
# Indeed
# =========================
INDEED_URL=https://es.indeed.com/jobs?q=programador+full+stack&l=Espa%C3%B1a&sort=date
INDEED_MAX_RESULTS=15
INDEED_HEADLESS=true
INDEED_SESSION_DIR=./data/indeed_session
INDEED_MIN_EXPECTED=8

# =========================
# InfoJobs
# =========================
INFOJOBS_URL=https://www.infojobs.net/jobsearch/search-results/list.xhtml?keyword=programador%20full%20stack&sortBy=PUBLICATION_DATE
INFOJOBS_MAX_RESULTS=60
INFOJOBS_HEADLESS=true
INFOJOBS_AUTO_ACCEPT_COOKIES=true
INFOJOBS_SESSION_DIR=./data/infojobs_session
INFOJOBS_CHALLENGE_WAIT_SEC=120
INFOJOBS_SCROLL_MODE=progressive
INFOJOBS_SCROLL_STEPS=7
INFOJOBS_SCROLL_PAUSE_MS=700
INFOJOBS_PAGES_TO_SCAN=1
INFOJOBS_MIN_EXPECTED=15
INFOJOBS_VERBOSE_LOGS=false
